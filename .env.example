# ==============================================================================
# Intellistrata Community Portal — Environment Configuration Example
# Copy this file to `.env` for local development.
# ==============================================================================

# API & Mock Mode
# - Set VITE_USE_MOCK_API=true to use local in-memory mock data (default for local dev)
# - Set VITE_USE_MOCK_API=false to connect to the live backend with Supabase auth
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:3000

# Supabase Authentication Configuration
# - Obtain URL and Anonymous/Publishable Key from your Supabase project dashboard
#   under Project Settings -> API.
# - SECURITY NOTE: ONLY use the Publishable/Anon key here. NEVER expose the
#   Supabase Service Role Key (secret) in frontend code or .env files.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
