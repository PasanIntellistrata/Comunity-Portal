  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@supabase/supabase-js": "^2.90.1",
    "framework7": "^9.0.0",
    "framework7-icons": "^4.0.0",
    "framework7-react": "^9.0.0",
    "lucide-react": "^1.46.0",
    "material-icons": "^1.13.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^4.2.1",
