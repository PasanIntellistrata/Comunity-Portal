# ==============================================================================
# Intellistrata Community Portal — Supabase Admin Provisioning Config Template
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.seed.local` (which is excluded from Git):
#    cp .env.seed.example .env.seed.local
# 2. Add your SUPABASE_SERVICE_ROLE_KEY from your Supabase Project Settings -> API.
# 3. Run the provisioning script:
#    npm run seed:users
#
# CRITICAL SECURITY RULES:
# - NEVER prefix admin/service keys with `VITE_` (prevents bundling into browser code).
# - NEVER commit `.env.seed.local` or service role keys to Git.
# - The Service Role Key bypasses all Row Level Security (RLS) policies.
# ==============================================================================

# Supabase Project URL (e.g. from VITE_SUPABASE_URL in .env)
SUPABASE_URL=https://qttjnrsbbsucfbbxugeu.supabase.co

# Supabase Secret Service Role Key (obtain from Supabase Dashboard -> Project Settings -> API)
# WARNING: Keep this strictly confidential. Never share or paste in chat/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Default development password applied when creating new test users
TEST_USER_PASSWORD=TestPass123!
